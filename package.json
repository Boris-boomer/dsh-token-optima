{
  "name": "dsh-token-optima",
  "description": "Deep context analysis for DeepSeek Harness: 64-token cache-block modeling, cache invalidation events, reasoning lifecycle, fine-grained source attribution.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "author": "Boris-boomer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boris-boomer/dsh-token-optima"
  },
  "homepage": "https://github.com/Boris-boomer/dsh-token-optima#readme",
  "bugs": {
    "url": "https://github.com/Boris-boomer/dsh-token-optima/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "token",
    "cache",
    "harness",
    "llm",
    "cost-tracker"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "!**/*.tsbuildinfo",
    "!**/*.log",
    "!**/.DS_Store"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.dts.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-token-optima"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "optionalDependencies": {
    "@huggingface/tokenizers": "^0.1.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^3.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}